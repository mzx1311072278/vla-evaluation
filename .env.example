# Copy to .env and fill in. Never commit real secrets.
# This file is loaded by docker-compose (env_file:) into the web + worker containers.

# Session secret used to sign browser cookies. REQUIRED before the web server starts.
# Generate with:  openssl rand -hex 32
VLA_EVAL_SESSION_SECRET=

# Absolute path (inside the containers) to the application YAML.
VLA_EVAL_CONFIG=/srv/vla-eval/config/app.yaml

# Evaluation profiles (read-only regular files) and credentials roots.
VLA_EVAL_PROFILES_ROOT=/srv/vla-eval/config/profiles
VLA_EVAL_CREDENTIALS_ROOT=/srv/vla-eval/data/credentials

# Initial password for non-interactive `create-user`. Leave blank to pass
# --password interactively. Never echo this value into logs.
VLA_EVAL_INITIAL_PASSWORD=

# Image tag / git SHA for tracking the deployed build.
VLA_EVAL_GIT_SHA=

# Destination directory for deploy/backup.sh (the systemd timer writes here).
VLA_EVAL_BACKUP_DIR=

# SQLite database file path (used by deploy/backup.sh).
VLA_EVAL_DB_PATH=/srv/vla-eval/data/db/app.sqlite3
